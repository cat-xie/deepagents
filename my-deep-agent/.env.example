# ==================================================
# 环境变量配置示例
# 使用前复制本文件为 .env，并填入真实值
#   cp .env.example .env
# ==================================================

# 阿里百炼 DashScope API Key（qwen 模型用）
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 模型名称（403 错误时换成你有权限的模型，如 qwen-plus / qwen-max / qwen-turbo）
DASHSCOPE_MODEL=qwen-plus

# Tavily 搜索 API Key（研究员子 agent 用）
# 申请地址：https://tavily.com/（每月 1000 次免费额度）
# 没有就留空，搜索功能会不可用
TAVILY_API_KEY=

# 是否使用 Docker 沙箱（true/false）
# true  = 启用 Docker 容器隔离 + execute 工具
# false = 使用本地文件系统 + permissions 权限控制
USE_DOCKER_SANDBOX=false
